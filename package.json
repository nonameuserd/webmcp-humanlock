{
  "name": "webmcp-humanlock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HUMANLOCK - The vault you cannot open alone. WebMCP Challenge submission.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.{ts,js,json}\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"*.{ts,js,json}\" \"index.html\"",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=humanlock --commit-dirty=true",
    "deploy:preview": "pnpm build && wrangler pages deploy dist --project-name=humanlock --branch=preview --commit-dirty=true",
    "cf:login": "wrangler login",
    "cf:preview": "wrangler pages dev dist --port 8788"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5",
    "webmcp-types": "^0.1.1",
    "wrangler": "^3.90.0"
  }
}
